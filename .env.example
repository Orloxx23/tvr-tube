# Estas variables son opcionales y solo aplican en dev.
# En producción (la app empaquetada) los binarios se descargan automáticamente
# a userData/bin/ en el primer arranque.

# Path absoluto al binario de yt-dlp. Si está en PATH, dejá en blanco.
YT_DLP_PATH=

# Path absoluto al binario de ffmpeg. Si está en PATH, dejá en blanco.
FFMPEG_PATH=

# (Opcional) cookies.txt en formato Netscape — útil si YouTube exige login.
YT_DLP_COOKIES_PATH=

# (Opcional) Args extra para el extractor de YouTube:
# YT_DLP_EXTRACTOR_ARGS=youtube:player_client=tv,web_safari
YT_DLP_EXTRACTOR_ARGS=

# ---- Cliente ----
NEXT_PUBLIC_APP_NAME=TVR Tube
