# ---- Cloudflare R2 (Fase 2+) ----
# Account ID: panel de Cloudflare → R2 → "Account ID"
R2_ACCOUNT_ID=

# API token con permiso Object Read/Write sobre el bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket (ej. "snatch-downloads")
R2_BUCKET=

# (Opcional) URL pública del bucket si exponés un dominio personalizado
R2_PUBLIC_URL=

# Tiempo de vida de las URLs pre-firmadas (segundos). Mínimo 60, máximo 3600.
SIGNED_URL_EXPIRES_SECONDS=900

# ---- Binarios locales (Fase 2+) ----
# Path al binario. Si están en PATH, podés dejarlos en blanco.
# Windows: usa rutas con doble backslash o forward slash.
YT_DLP_PATH=
FFMPEG_PATH=

# ---- Redis / Upstash (Fase 3) ----
# Para BullMQ. En desarrollo, podés correr Redis local: redis://localhost:6379
REDIS_URL=

# (Opcional) Redis separado para rate limiting
RATE_LIMIT_REDIS_URL=

# ---- Cliente ----
NEXT_PUBLIC_APP_NAME=Snatch
